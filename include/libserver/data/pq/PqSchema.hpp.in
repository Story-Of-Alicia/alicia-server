// GENERATED FILE - DO NOT EDIT.
// Generated by CMake from scripts/schema/001_initial.sql, which stays the
// single source of truth for the schema. Edit that file instead.

#ifndef PQSCHEMA_HPP
#define PQSCHEMA_HPP

#include <string>
#include <string_view>

namespace server
{

//! The statements creating the data schema, applied by PqDataSource when the
//! schema is not present yet.
//!
//! Split into chunks because MSVC rejects a single string literal of the size
//! of the whole schema. The split points are arbitrary byte offsets, so the
//! chunks are only meaningful once joined back together.
constexpr std::string_view DataSchemaSqlChunks[]{
@AliciaDataSchemaSql@};

//! Joins the schema chunks back into the whole schema.
//! @returns The statements creating the data schema.
inline std::string GetDataSchemaSql()
{
  std::string sql;

  size_t length = 0;
  for (const auto& chunk : DataSchemaSqlChunks)
    length += chunk.size();
  sql.reserve(length);

  for (const auto& chunk : DataSchemaSqlChunks)
    sql.append(chunk);

  return sql;
}

} // namespace server

#endif // PQSCHEMA_HPP
